@page "/magazijn"
@rendermode InteractiveWebAssembly
@using Magazijn_Website.Client.Models
@using System.Collections.Generic

<link rel="stylesheet" href="StyleSheet.css" />

<PageTitle>Magazijn</PageTitle>

<h1>Magazijn</h1>
<h2>Nieuw item toevoegen</h2>
<input @bind="newItemName" placeholder="Itemnaam" />
<input type="number" @bind="newItemId" min="1" />
<input type="number" @bind="newItemStock" min="0" />
@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="borrowed">@errorMessage</p>
}
<button class="btn btn-primary" @onclick="AddItem">Item toevoegen</button>


@foreach (var item in items)
{   
    <div class="item-card">
        <p>ID: @item.Id - Name: @item.Name</p>
        <p>Voorraad: @item.Stock</p>
        <p class="@(item.Stock == 0 ? "borrowed" : "available")">Status: @(item.Stock == 0 ? "Uitgeleend" : "Beschikbaar")</p>
        <button class="btn btn-primary" @onclick="() => BorrowItem(item)" disabled="@(item.Stock == 0)">Item Uitlenen</button>
        <button class="btn btn-primary" @onclick="() => ObtainItem(item)">Item Terugkrijgen</button>
    </div>
}

@code {
    private List<Item> items = new List<Item>
    {
        new Item { Id = 8055, Stock = 7, Name = "Human Child"},
        new Item { Id = 2017, Stock = 6, Name = "Acer Predator 21X"},
        new Item { Id = 4444, Stock = 3, Name = "A stick of Lit Dynamite"},
        new Item { Id = 69420, Stock = 9, Name = "Scott de Weerd"},
    };

    private void ObtainItem(Item item)
    {
        errorMessage = "";
        item.Stock = item.Stock + 1;
    }

    private void BorrowItem(Item item)
    {   
        if (item.Stock <= 0)
        {
            if (item.Stock < 0)
            {
                errorMessage = "Item below Zero, how did this happen? achievement get: 'how did we get here?'";
                item.Stock = 0;
                return;
            }
            errorMessage = "Kan item niet uitlenen, geen items over om uit te lenen.";
            return;
        }

        item.Stock = item.Stock - 1;
        errorMessage = "";
    }

    private string newItemName = "";
    private int newItemId = 1;
    private int newItemStock = 1;
    private string errorMessage = "";

    private void AddItem()
    {
        if (newItemStock < 0)
        {
            errorMessage = "De Voorraad is negatief! Kies een geldig voorraad.";
            return;
        }

        if (newItemId <= 0)
        {
            errorMessage = "Dit ID is 0 of negatief! Kies een geldig ID nummer.";
            return;
        }

        bool idExists = items.Any(i => i.Id == newItemId);
        if (idExists)
        {
            errorMessage = "Dit ID bestaat al! Kies een uniek ID.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newItemName))
        {
            errorMessage = "Vul een geldige naam in.";
            return;
        }

        errorMessage = "";
        Item newItem = new Item{Id = newItemId, Stock = newItemStock, Name = newItemName};
        items.Add(newItem);
        newItemName = "";
        newItemId = 1;
        newItemStock = 1;
    }
}